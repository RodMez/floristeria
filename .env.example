# ══════════════════════════════════════════════════════════════
# Floristeria - Variables de Entorno (template)
# Copia este archivo como .env y reemplaza los placeholders.
# ══════════════════════════════════════════════════════════════

# ── BASE DE DATOS ──────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/floristeria_db
DB_USER=admin
DB_PASS=***
DB_NAME=floristeria_db

# ── JWT ────────────────────────────────────────────────────
JWT_SECRET=***

# ── IMAGEKIT ───────────────────────────────────────────────
IMAGEKIT_PRIVATE_KEY=***
IMAGEKIT_PUBLIC_KEY=***
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/***

# ── CORS ───────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://flores.jaiver.com,http://localhost:3000

# ── WOMPI (sandbox — cambiar a producción antes del lanzamiento) ──
WOMPI_PUBLIC_KEY=pub_test_***
WOMPI_INTEGRITY_SECRET=test_integrity_***
WOMPI_EVENTS_SECRET=test_events_***

# ── BREVO (email transaccional) ────────────────────────────
BREVO_API_KEY=***
BREVO_SENDER_EMAIL=sender@example.com
BREVO_SENDER_NAME=FloristeriaTAO

# ── FRONTEND ───────────────────────────────────────────────
FRONTEND_URL=https://flores.jaiver.com

# ── SEEDER (solo desarrollo — NO usar en producción) ────────
ADMIN_SEED_PASSWORD=***
